# Bind-mounted sibling repos are untracked by git (see .gitignore: repos/**),
# which also hides them from Cursor's index. Re-include repos/ for Cursor only.
!repos/
!repos/**

# Keep heavy / generated / sensitive paths OUT of the index and AI access,
# even though repos/** is re-included above (explicit = deterministic).
repos/**/node_modules/
repos/**/dist/
repos/**/dist-webview/
repos/**/data/
repos/**/.env
repos/**/.env.*
repos/marloth-story/content/.obsidian/
repos/marloth-story/.marloth/
repos/marloth-story/.tome/
